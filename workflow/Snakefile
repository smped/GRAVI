#######################
## Update parameters ##
#######################
def set_params(config, targets):
	out = {}
	for i in targets:
		out[i] = config['default'].copy()
		if i in config.keys():
			for j in config[i].keys():
				out[i][j] = config[i][j]
	return(out)

## This should be OK at this point
diff_sig_param = set_params(config['differential_signal'], targets)
rm_targets = [] # Holds targets with no valid contrasts
for i in diff_sig_param.keys():
	poss_levels = set(df['treat'][df['target'] == i])
	valid_contrasts = []
	J = len(diff_sig_param[i]['contrasts'])
	for j in range(J):
		supplied = diff_sig_param[i]['contrasts'][j].copy()
		valid = poss_levels.intersection(supplied)
		if len(valid) == 2:
			valid_contrasts.extend([supplied])
	if len(valid_contrasts):
		diff_sig_param[i]['contrasts'] = valid_contrasts
		diff_sig_param[i]['target'] = i
	else:
		rm_targets.extend([i])

if len(rm_targets): # Remove those without valid contrasts
	for i in rm_targets:
		del diff_sig_param[i]

with open(os.path.join(json_path, "differential_signal_param.json"), 'w') as fp:
	json.dump(diff_sig_param, fp, indent = 4)

all_contrasts = []
if len(diff_sig_param):
	for i in diff_sig_param.keys():
		for j in range(len(diff_sig_param[i]['contrasts'])):
			lv = diff_sig_param[i]['contrasts'][j]
			cont = i + "_" + lv[0] + "_" + lv[1]
			all_contrasts.extend([cont])

all_contrasts.sort()

## Turn of all Diff Signal & Pairwise comps by uncommenting this line
# all_contrasts = []

## use the contrasts to define all pairwise comparisons
pairs = []
for p in list(itertools.combinations(all_contrasts, 2)):
	pairs.extend([p[0] + "-" + p[1]])

## Turn of all Pairwise comps by uncommenting this line
# pairs = []

## Make sure nfr, pairwise & shared are added to the options for motif analysis
motif_cats = targets.copy()
if (len(targets) >1):
	motif_cats.extend(['shared'])

if set([config['modules']['nfr']]).intersection(targets):
	motif_cats.extend(['nfr'])

if pairs:
	motif_cats.extend(['pairwise'])

## Define all pairwise directions for comparisons, excluding both undetected
pw_dirs = []
if pairs:
    dirs = ['increased', 'decreased', 'unchanged', 'undetected']
    for i in range(4):
        for j in range(4):
            pw_dirs.extend([dirs[i] + "_" + dirs[j]])
    pw_dirs.remove('undetected_undetected')



